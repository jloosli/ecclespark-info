---
// Variant B — "Next Broadcast first": phone-first hero for the soonest Upcoming Broadcast with one big button;
// other Upcoming ones as compact rows; Past ones demoted to a small "Recent" list; announcements below.
import type { Shown } from '../visibility';
import type { Announcement, Broadcast } from '../model';
interface Props { broadcasts: Shown<Broadcast>[]; announcements: Shown<Announcement>[] }
const { broadcasts, announcements } = Astro.props;
import { fmtDay, fmtTime, fmtLong, linkHint } from '../format';
const upcoming = broadcasts.filter((b) => b.label === 'Upcoming');
const past = broadcasts.filter((b) => b.label === 'Past').reverse();
const [next, ...later] = upcoming;
---
<main class="max-w-xl mx-auto px-4 py-6 space-y-6">
  {next ? (
    <section class="rounded-2xl bg-white dark:bg-slate-800 shadow-md border border-slate-200 dark:border-slate-700 p-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent">Next broadcast</p>
      <h2 class="mt-2 text-2xl font-bold">{next.item.title}</h2>
      <p class="mt-3 text-lg">{fmtDay(next.item.starts_at)}</p>
      <p class="text-3xl font-bold tabular-nums">{fmtTime(next.item.starts_at)}</p>
      <a href={next.item.link} target="_blank" rel="noopener noreferrer"
         class="mt-6 block w-full rounded-xl bg-primary hover:bg-primary-hover dark:bg-accent text-white text-lg font-semibold py-4">
        Join the broadcast
      </a>
      <p class="mt-2 text-xs text-slate-500">Opens {linkHint(next.item.link)}</p>
    </section>
  ) : (
    <section class="rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-600 p-8 text-center text-slate-600 dark:text-slate-300">
      <p class="text-lg font-semibold">No broadcast is posted yet</p>
      <p class="mt-1 text-sm">The link for the next Meeting usually appears a few days before. Check back soon.</p>
    </section>
  )}

  {later.length > 0 && (
    <section>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">Also coming up</h3>
      <ul class="divide-y divide-slate-200 dark:divide-slate-700 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
        {later.map(({ item }) => (
          <li><a href={item.link} target="_blank" rel="noopener noreferrer" class="flex justify-between gap-3 p-4 hover:bg-slate-50 dark:hover:bg-slate-700">
            <span><span class="font-medium">{item.title}</span><br /><span class="text-sm text-slate-500">{fmtLong(item.starts_at)}</span></span>
            <span class="self-center text-accent">→</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  {announcements.length > 0 && (
    <section class="space-y-3">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Announcements</h3>
      {announcements.map(({ item }) => (
        <div class="rich rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4 text-sm" set:html={item.bodyHtml} />
      ))}
    </section>
  )}

  {past.length > 0 && (
    <section>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">Recent</h3>
      <ul class="text-sm space-y-1">
        {past.map(({ item }) => (
          <li><a href={item.link} target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-300 underline">{item.title}, {fmtDay(item.starts_at)}</a></li>
        ))}
      </ul>
    </section>
  )}
</main>
