---
// Variant A — "Faithful port": today's page structure, announcements on top, card grid of Broadcasts.
// Whole card is the click target (#269: one public clickable URL).
import type { Shown } from '../visibility';
import type { Announcement, Broadcast } from '../model';
interface Props { broadcasts: Shown<Broadcast>[]; announcements: Shown<Announcement>[] }
const { broadcasts, announcements } = Astro.props;
import { fmtLong, linkHint } from '../format';
---
<main class="max-w-4xl mx-auto px-6 py-8">
  {announcements.length > 0 && (
    <section class="mb-8">
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-4">Announcements</h2>
      {announcements.map(({ item }) => (
        <div class="rich border-l-4 border-accent bg-blue-50 dark:bg-slate-800/60 rounded-r-lg p-4 mb-3 text-sm text-slate-700 dark:text-slate-300" set:html={item.bodyHtml} />
      ))}
    </section>
  )}
  <section>
    {broadcasts.length === 0 ? (
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-4">No upcoming broadcasts are scheduled</h2>
    ) : (
      <>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-6">Broadcasts</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {broadcasts.map(({ item, label }) => (
            <a href={item.link} target="_blank" rel="noopener noreferrer"
               class:list={['bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5 flex flex-col gap-3 hover:border-accent transition-colors', label === 'Past' && 'opacity-70']}>
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100 leading-snug">{item.title}</h3>
                <span class:list={['shrink-0 text-xs font-medium px-2 py-0.5 rounded-full', label === 'Upcoming' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600']}>{label}</span>
              </div>
              <p class="text-sm text-slate-500 dark:text-slate-400">{fmtLong(item.starts_at)}</p>
              <span class="mt-auto text-sm font-medium text-accent">{label === 'Past' ? 'Watch recording' : 'Open broadcast'} on {linkHint(item.link)} →</span>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</main>
