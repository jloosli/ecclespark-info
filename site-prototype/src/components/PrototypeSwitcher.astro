---
// PROTOTYPE — floating variant/scenario/clock switcher. Dev only.
import { SCENARIOS } from '../fixtures';
interface Props { variants: { key: string; name: string }[]; current: string; scenario: string; nowIso: string; nowOverridden: boolean; state: string }
const { variants, current, scenario, nowIso, nowOverridden, state } = Astro.props;
const cur = variants.find((v) => v.key === current)!;
---
{import.meta.env.DEV && (
  <div id="proto-bar" data-variants={JSON.stringify(variants.map((v) => v.key))} data-current={current}
       class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex flex-wrap items-center justify-center gap-2 rounded-2xl bg-black text-white text-sm px-3 py-2 shadow-2xl ring-2 ring-fuchsia-500 font-mono max-w-[95vw]">
    <button data-dir="-1" class="px-2 hover:text-fuchsia-300" aria-label="Previous variant">◀</button>
    <span>{cur.key} ({cur.name})</span>
    <button data-dir="1" class="px-2 hover:text-fuchsia-300" aria-label="Next variant">▶</button>
    <span class="opacity-40">|</span>
    <select id="proto-scenario" class="bg-black border border-white/30 rounded px-1">
      {SCENARIOS.map((s) => <option value={s} selected={s === scenario}>{s}</option>)}
    </select>
    <input id="proto-now" type="datetime-local" value={nowIso.slice(0, 16)} class="bg-black border border-white/30 rounded px-1" title="Clock (UTC)" />
    {nowOverridden && <a href="#" id="proto-now-reset" class="underline">real now</a>}
    <details class="relative">
      <summary class="cursor-pointer select-none">state</summary>
      <pre class="absolute bottom-8 right-0 w-[min(36rem,90vw)] max-h-[60vh] overflow-auto bg-black/95 p-3 rounded-lg text-xs whitespace-pre-wrap">{state}</pre>
    </details>
  </div>
)}
<script>
  const bar = document.getElementById('proto-bar');
  if (bar) {
    const keys: string[] = JSON.parse(bar.dataset.variants!);
    const go = (mut: (p: URLSearchParams) => void) => { const u = new URL(location.href); mut(u.searchParams); location.replace(u); };
    const cycle = (d: number) => go((p) => p.set('variant', keys[(keys.indexOf(bar.dataset.current!) + d + keys.length) % keys.length]));
    bar.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => cycle(Number(b.dataset.dir))));
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowLeft') cycle(-1);
      if (e.key === 'ArrowRight') cycle(1);
    });
    document.getElementById('proto-scenario')!.addEventListener('change', (e) => go((p) => p.set('scenario', (e.target as HTMLSelectElement).value)));
    document.getElementById('proto-now')!.addEventListener('change', (e) => go((p) => p.set('now', (e.target as HTMLInputElement).value + ':00Z')));
    document.getElementById('proto-now-reset')?.addEventListener('click', (e) => { e.preventDefault(); go((p) => p.delete('now')); });
  }
</script>
